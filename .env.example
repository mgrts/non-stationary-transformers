# Copy this file to `.env` and adjust the values for your environment.
# `src/config.py` reads these via python-dotenv. Every variable has a sensible
# default in config.py, so a missing .env will not crash the project - this file
# documents the available knobs and their recommended starting values.

# Absolute path to the repository root. If left unset, config.py infers it from
# the location of src/config.py, so you usually do not need to set this.
# PROJECT_ROOT_DIR=/absolute/path/to/non-stationary-transformers

# Training loss: MSE | L1 | Cauchy
LOSS_TYPE=MSE

# Synthetic data generator: random | sine
DATA_TYPE=random

# Smoothing kernel: gaussian | sine | cosine | combined_cosine_gaussian
SMOOTHING_TYPE=gaussian

# Length of the stable regime before the non-stationary transition:
# short | moderate | long
STABILITY_PERIOD=moderate

# Smoothing kernel hyper-parameters
KERNEL_SIZE=25
SIGMA=5
PERIOD=50

# Data generation
SEQUENCE_LENGTH=300
N_TIME_SERIES=1000
SINE_INTERVAL=0.1

# Loss / training hyper-parameters
CAUCHY_LOSS_GAMMA=1.0
BS=32
# Batch size for the smaller real-world OWID dataset (train_model_real.py)
REAL_BS=16
# Fraction of each sequence used as encoder input; the rest is the forecast target
LEAVE_RATIO=0.8
NUM_EPOCHS=10
# Model hyper-parameters (all logged to MLflow)
FEATURE_DIM=128
NUM_HEADS=8
NUM_LAYERS=2
LR=0.001
# Number of example prediction plots logged during evaluation / predict
NUM_VIS_EXAMPLES=10
# Early-stopping patience (epochs without validation improvement)
PATIENCE=5
COVID_SEQ_CHUNK_SIZE=300

# --- Data split ---------------------------------------------------------------
# Three-way split: train = 1 - VAL_RATIO - TEST_RATIO
VAL_RATIO=0.1
TEST_RATIO=0.1

# --- Normalization ------------------------------------------------------------
# Causal (history-window-fit) scaler applied to every dataset: robust | standard
# 'robust' (median/IQR) is recommended for the heavy-tailed levy-stable data.
NORMALIZATION_SCALER=robust

# --- Reproducibility ----------------------------------------------------------
# Seed for data generation and the train/val/test split (kept fixed so the
# multi-seed model sweep measures model variance, not split noise).
RANDOM_STATE=927

# --- Experiment sweep (training_pipeline.py), comma-separated ------------------
INITIAL_ALPHAS=2
FINAL_ALPHAS=2,1.9,1.5
STABILITY_PERIODS=short,moderate,long
SMOOTHING_TYPES=gaussian,combined_cosine_gaussian
# Model-training seeds: each data condition is trained once per seed
SEEDS=927,123,2024
